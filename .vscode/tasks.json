{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android Emulator: Ensure Up (auto)",
      "type": "shell",
      "command": "bash /workspaces/ensure-up.sh",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Android Emulator: Start Everything",
      "type": "shell",
      "command": "bash /workspaces/emu.sh start",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Android Emulator: Status",
      "type": "shell",
      "command": "bash /workspaces/emu.sh status",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Android Emulator: Stop Everything",
      "type": "shell",
      "command": "bash /workspaces/emu.sh stop",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Android Emulator + Viewer",
      "type": "shell",
      "command": "bash /workspaces/run-all.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
